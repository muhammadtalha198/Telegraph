# OmniRoute / upstream
BASE_URL=https://omni-chat.13.237.89.59.sslip.io
OMNIROUTE_API_KEY=sk-your-key

# Telegraph node (validation API)
NODE_URL=https://devnode.telegraphprotocol.com
INTERNAL_SECRET=telegraph-internal-secret

# On-chain (Base Sepolia)
DIAMOND=0x5a2324aA18613FAD4e44bDF0d6c73Ec1f6D87ff8
RPC_URL=https://sepolia.base.org
MINER_PRIVATE_KEY=0xYOUR_PRIVATE_KEY
FEE_ADDRESS=0xYourFeeAddress
MIN_PRICE_USDC=10000

# Public YAML hosts (nginx on OmniRoute box)
HOST_PREFIX_CHAT=https://omni-chat.13.237.89.59.sslip.io/miner-yamls
HOST_PREFIX_RESP=https://omni-chat.13.237.89.59.sslip.io/response-yamls

# Dropbox (optional)
DROPBOX_ACCESS_TOKEN=

# Optional: fall back to paste.rs when Dropbox token is missing (dev only)
ALLOW_PASTE_FALLBACK=true

# YAML hosting: omni over SSH (preferred). paste.rs is OFF unless ALLOW_PASTE_FALLBACK=true (public DELETE risk)
OMNI_SSH_KEY=/path/to/telegraphNode1.pem
OMNI_SSH_TARGET=ubuntu@13.237.89.59
OMNI_YAML_DIR=/var/www/miner-yamls
ALLOW_PASTE_FALLBACK=false
